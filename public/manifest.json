{
  "manifest_version": 3,
  "name": "Momento",
  "short_name": "Momento",
  "version": "1.0.0",
  "description": "Make every moment count. A calm, all-in-one productivity dashboard for your new tab.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "action": { "default_popup": "popup.html", "default_title": "Momento", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "notifications", "tabs", "tabGroups", "declarativeNetRequest", "identity", "search", "geolocation"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [{ "resources": ["blocked.html", "assets/*"], "matches": ["<all_urls>"] }],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+M" }, "description": "Open Momento quick panel" }
  }
}
